digraph G {
  graph [rankdir=TB, nodesep=0.45, ranksep=0.32, fontname="DejaVu Sans", labelloc=t, fontsize=14, label="PAP 6: install.sh - Installation", pad=0.3];
  node [fontname="DejaVu Sans", fontsize=11, margin="0.16,0.08"];
  edge [fontname="DejaVu Sans", fontsize=10];
  s [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Start: ./install.sh"];
  root [shape=diamond, style=filled, fillcolor="#fff4d6", label="EUID = 0?"];
  sudo [shape=box, style=filled, fillcolor="#ffffff", label="exec sudo bash \"$0\" \"$@\""];
  intro [shape=parallelogram, style=filled, fillcolor="#e6f4e6", label="Einleitungstext anzeigen\n(Liste aller Änderungen)"];
  d1 [shape=diamond, style=filled, fillcolor="#fff4d6", label="fortfahren? (y/n)"];
  e1a [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Ende (Exit 1)"];
  apt [shape=box, style=filled, fillcolor="#ffffff", label="apt-get -y install rsync"];
  cp [shape=box, style=filled, fillcolor="#ffffff", label="minibak.sh -> /usr/bin/minibak kopieren\nconf -> /etc/minibak.conf kopieren\nconf -> /etc/minibak.conf.template kopieren"];
  d2 [shape=diamond, style=filled, fillcolor="#fff4d6", label="jede Kopie erfolgreich?"];
  err [shape=parallelogram, style=filled, fillcolor="#e6f4e6", label="Fehlermeldung,\nLog-Eintrag"];
  e1b [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Ende (Exit 1)"];
  ch [shape=box, style=filled, fillcolor="#ffffff", label="chmod +x /usr/bin/minibak\nchmod 644 /etc/minibak.conf*"];
  src [shape=box, style=filled, fillcolor="#ffffff", label="source ./conf\n(bool_timerEnabled, Unit-Funktion)"];
  gen [shape=box, style=filled, fillcolor="#ffffff", label="func_saveSystemdUnitsToTmp\n(Units nach /tmp/minibak)"];
  un [shape=box, style=filled, fillcolor="#ffffff", label="minibak.service und minibak.timer nach\n/etc/systemd/system kopieren,\ntemporäre Kopien löschen"];
  rl [shape=box, style=filled, fillcolor="#ffffff", label="systemctl daemon-reload"];
  d3 [shape=diamond, style=filled, fillcolor="#fff4d6", label="bool_timerEnabled = true?"];
  en [shape=box, style=filled, fillcolor="#ffffff", label="systemctl enable --now minibak.timer"];
  di [shape=box, style=filled, fillcolor="#ffffff", label="systemctl disable --now minibak.timer"];
  e0 [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Ende (Exit 0)"];
  s -> root;
  root -> intro [label="ja"];
  root -> sudo [label="nein"];
  intro -> d1;
  d1 -> apt [label="ja"];
  d1 -> e1a [label="nein"];
  apt -> cp;
  cp -> d2;
  d2 -> ch [label="ja"];
  d2 -> err [label="nein"];
  err -> e1b;
  ch -> src;
  src -> gen;
  gen -> un;
  un -> rl;
  rl -> d3;
  d3 -> en [label="ja"];
  d3 -> di [label="nein"];
  en -> e0;
  di -> e0;
  sudo -> s [label="(startet erneut als root)", constraint=false, style=dashed];
}
