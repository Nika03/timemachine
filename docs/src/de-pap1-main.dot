digraph G {
  graph [rankdir=TB, nodesep=0.45, ranksep=0.32, fontname="DejaVu Sans", labelloc=t, fontsize=14, label="PAP 1: minibak.sh - Hauptprogramm", pad=0.3];
  node [fontname="DejaVu Sans", fontsize=11, margin="0.16,0.08"];
  edge [fontname="DejaVu Sans", fontsize=10];
  s [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Start: minibak [Optionen]"];
  root [shape=diamond, style=filled, fillcolor="#fff4d6", label="EUID = 0?"];
  sudo [shape=box, style=filled, fillcolor="#ffffff", label="exec sudo bash \"$0\" \"$@\"\n(Neustart als root)"];
  init [shape=box, style=filled, fillcolor="#ffffff", label="Standardwerte setzen,\nHilfetexte definieren"];
  tmp [shape=box, style=filled, fillcolor="#ffffff", label="/tmp/minibak anlegen,\nStartzeile ins temporäre Log"];
  opt [shape=record, style=filled, fillcolor="#f3e6f7", label="| Optionen verarbeiten\n(PAP 2) |"];
  d1 [shape=diamond, style=filled, fillcolor="#fff4d6", label="dir_src gesetzt?"];
  d2 [shape=diamond, style=filled, fillcolor="#fff4d6", label="dir_src vorhanden?"];
  d3 [shape=diamond, style=filled, fillcolor="#fff4d6", label="dir_dest gesetzt?"];
  d4 [shape=diamond, style=filled, fillcolor="#fff4d6", label="dir_dest vorhanden?"];
  mk [shape=box, style=filled, fillcolor="#ffffff", label="mkdir --parents dir_dest"];
  d5 [shape=diamond, style=filled, fillcolor="#fff4d6", label="angelegt?"];
  err [shape=parallelogram, style=filled, fillcolor="#e6f4e6", label="Fehlermeldung,\nLog-Eintrag"];
  e1 [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Ende (Exit 1)"];
  names [shape=box, style=filled, fillcolor="#ffffff", label="currentBackupDir = dir_dest/backup_<Zeitstempel>\nlastBackup = neuester Eintrag in dir_dest"];
  d6 [shape=diamond, style=filled, fillcolor="#fff4d6", label="dir_dest leer?"];
  full [shape=box, style=filled, fillcolor="#ffffff", label="mkdir currentBackupDir\nrsync -aH dir_src currentBackupDir"];
  inc [shape=box, style=filled, fillcolor="#ffffff", label="mkdir currentBackupDir\nrsync -aHv --link-dest=lastBackup\ndir_src currentBackupDir"];
  ev [shape=box, style=filled, fillcolor="#ffffff", label="rsync-Exit-Code auswerten,\nLog-Eintrag schreiben"];
  d7 [shape=diamond, style=filled, fillcolor="#fff4d6", label="Exit-Code = 0?"];
  prune [shape=record, style=filled, fillcolor="#f3e6f7", label="| Aufbewahrung\n(PAP 5) |"];
  e0 [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Ende (Exit 0)"];
  en [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Ende mit dem\nrsync-Exit-Code"];
  s -> root;
  root -> init [label="ja"];
  root -> sudo [label="nein"];
  init -> tmp;
  tmp -> opt;
  opt -> d1;
  d1 -> d2 [label="ja"];
  d1 -> err [label="nein"];
  d2 -> d3 [label="ja"];
  d2 -> err [label="nein"];
  d3 -> d4 [label="ja"];
  d3 -> err [label="nein"];
  d4 -> names [label="ja"];
  d4 -> mk [label="nein"];
  mk -> d5;
  d5 -> names [label="ja"];
  d5 -> err [label="nein"];
  err -> e1;
  names -> d6;
  d6 -> full [label="ja"];
  d6 -> inc [label="nein"];
  full -> ev;
  inc -> ev;
  ev -> d7;
  d7 -> prune [label="ja"];
  d7 -> en [label="nein"];
  prune -> e0;
  sudo -> s [label="(startet erneut als root)", constraint=false, style=dashed];
}
