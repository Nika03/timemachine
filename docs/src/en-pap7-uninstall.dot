digraph G {
  graph [rankdir=TB, nodesep=0.45, ranksep=0.32, fontname="DejaVu Sans", labelloc=t, fontsize=14, label="PAP 7: install.sh uninstall - removal", pad=0.3];
  node [fontname="DejaVu Sans", fontsize=11, margin="0.16,0.08"];
  edge [fontname="DejaVu Sans", fontsize=10];
  s [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Start: ./install.sh uninstall"];
  root [shape=diamond, style=filled, fillcolor="#fff4d6", label="EUID = 0?"];
  sudo [shape=box, style=filled, fillcolor="#ffffff", label="exec sudo bash \"$0\" \"$@\""];
  intro [shape=parallelogram, style=filled, fillcolor="#e6f4e6", label="show intro text"];
  d1 [shape=diamond, style=filled, fillcolor="#fff4d6", label="continue? (y/N)"];
  e1 [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Exit 1"];
  q [shape=parallelogram, style=filled, fillcolor="#e6f4e6", label="ask: remove rsync? delete logs?\ndelete config? clear /tmp/minibak?\n(default: no)"];
  rmbin [shape=box, style=filled, fillcolor="#ffffff", label="delete /usr/bin/minibak\n(warning if missing)"];
  d2 [shape=diamond, style=filled, fillcolor="#fff4d6", label="minibak.timer known\nand enabled?"];
  dt [shape=box, style=filled, fillcolor="#ffffff", label="systemctl disable --now minibak.timer"];
  d3 [shape=diamond, style=filled, fillcolor="#fff4d6", label="minibak.service known?"];
  wait [shape=box, style=filled, fillcolor="#ffffff", label="wait while the service is\nactive or activating,\nthen systemctl stop"];
  rmu [shape=box, style=filled, fillcolor="#ffffff", label="delete minibak.timer and\nminibak.service in /etc/systemd/system\n(warning if missing)"];
  rl [shape=box, style=filled, fillcolor="#ffffff", label="systemctl daemon-reload\nsystemctl reset-failed"];
  d4 [shape=diamond, style=filled, fillcolor="#fff4d6", label="answered yes: rsync?"];
  o4 [shape=box, style=filled, fillcolor="#ffffff", label="apt-get -y remove rsync"];
  d5 [shape=diamond, style=filled, fillcolor="#fff4d6", label="answered yes: logs?"];
  o5 [shape=box, style=filled, fillcolor="#ffffff", label="delete /var/log/minibak.log"];
  d6 [shape=diamond, style=filled, fillcolor="#fff4d6", label="answered yes: config?"];
  o6 [shape=box, style=filled, fillcolor="#ffffff", label="delete /etc/minibak.conf and\n/etc/minibak.conf.template"];
  d7 [shape=diamond, style=filled, fillcolor="#fff4d6", label="answered yes: /tmp?"];
  o7 [shape=box, style=filled, fillcolor="#ffffff", label="delete /tmp/minibak"];
  e0 [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="End (backups are never touched)"];
  s -> root;
  root -> intro [label="yes"];
  root -> sudo [label="no"];
  intro -> d1;
  d1 -> q [label="yes"];
  d1 -> e1 [label="no"];
  q -> rmbin;
  rmbin -> d2;
  d2 -> dt [label="yes"];
  d2 -> d3 [label="no"];
  dt -> d3;
  d3 -> wait [label="yes"];
  d3 -> rmu [label="no"];
  wait -> rmu;
  rmu -> rl;
  rl -> d4;
  d4 -> o4 [label="yes"];
  d4 -> d5 [label="no"];
  o4 -> d5;
  d5 -> o5 [label="yes"];
  d5 -> d6 [label="no"];
  o5 -> d6;
  d6 -> o6 [label="yes"];
  d6 -> d7 [label="no"];
  o6 -> d7;
  d7 -> o7 [label="yes"];
  d7 -> e0 [label="no"];
  o7 -> e0;
  sudo -> s [label="(starts again as root)", constraint=false, style=dashed];
}
