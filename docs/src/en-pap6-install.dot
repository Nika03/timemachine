digraph G {
  graph [rankdir=TB, nodesep=0.45, ranksep=0.32, fontname="DejaVu Sans", labelloc=t, fontsize=14, label="PAP 6: install.sh - installation", pad=0.3];
  node [fontname="DejaVu Sans", fontsize=11, margin="0.16,0.08"];
  edge [fontname="DejaVu Sans", fontsize=10];
  s [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Start: ./install.sh"];
  root [shape=diamond, style=filled, fillcolor="#fff4d6", label="EUID = 0?"];
  sudo [shape=box, style=filled, fillcolor="#ffffff", label="exec sudo bash \"$0\" \"$@\""];
  intro [shape=parallelogram, style=filled, fillcolor="#e6f4e6", label="show intro text\n(list of all changes)"];
  d1 [shape=diamond, style=filled, fillcolor="#fff4d6", label="continue? (y/n)"];
  e1a [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Exit 1"];
  apt [shape=box, style=filled, fillcolor="#ffffff", label="apt-get -y install rsync"];
  cp [shape=box, style=filled, fillcolor="#ffffff", label="copy minibak.sh -> /usr/bin/minibak\ncopy conf -> /etc/minibak.conf\ncopy conf -> /etc/minibak.conf.template"];
  d2 [shape=diamond, style=filled, fillcolor="#fff4d6", label="every copy successful?"];
  err [shape=parallelogram, style=filled, fillcolor="#e6f4e6", label="error message,\nlog entry"];
  e1b [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Exit 1"];
  ch [shape=box, style=filled, fillcolor="#ffffff", label="chmod +x /usr/bin/minibak\nchmod 644 /etc/minibak.conf*"];
  src [shape=box, style=filled, fillcolor="#ffffff", label="source ./conf\n(bool_timerEnabled, unit function)"];
  gen [shape=box, style=filled, fillcolor="#ffffff", label="func_saveSystemdUnitsToTmp\n(units into /tmp/minibak)"];
  un [shape=box, style=filled, fillcolor="#ffffff", label="copy minibak.service and minibak.timer\nto /etc/systemd/system,\ndelete temp copies"];
  rl [shape=box, style=filled, fillcolor="#ffffff", label="systemctl daemon-reload"];
  d3 [shape=diamond, style=filled, fillcolor="#fff4d6", label="bool_timerEnabled = true?"];
  en [shape=box, style=filled, fillcolor="#ffffff", label="systemctl enable --now minibak.timer"];
  di [shape=box, style=filled, fillcolor="#ffffff", label="systemctl disable --now minibak.timer"];
  e0 [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="End (Exit 0)"];
  s -> root;
  root -> intro [label="yes"];
  root -> sudo [label="no"];
  intro -> d1;
  d1 -> apt [label="yes"];
  d1 -> e1a [label="no"];
  apt -> cp;
  cp -> d2;
  d2 -> ch [label="yes"];
  d2 -> err [label="no"];
  err -> e1b;
  ch -> src;
  src -> gen;
  gen -> un;
  un -> rl;
  rl -> d3;
  d3 -> en [label="yes"];
  d3 -> di [label="no"];
  en -> e0;
  di -> e0;
  sudo -> s [label="(starts again as root)", constraint=false, style=dashed];
}
