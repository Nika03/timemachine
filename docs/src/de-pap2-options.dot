digraph G {
  graph [rankdir=TB, nodesep=0.45, ranksep=0.32, fontname="DejaVu Sans", labelloc=t, fontsize=14, label="PAP 2: Optionsverarbeitung (getopts \":s:d:vhHc:x\")", pad=0.3];
  node [fontname="DejaVu Sans", fontsize=11, margin="0.16,0.08"];
  edge [fontname="DejaVu Sans", fontsize=10];
  s [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Start Optionsschleife"];
  more [shape=diamond, style=filled, fillcolor="#fff4d6", label="weitere Option?"];
  ret [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Zurück zum Hauptprogramm"];
  sw [shape=diamond, style=filled, fillcolor="#fff4d6", label="welche Option?"];
  set [shape=box, style=filled, fillcolor="#ffffff", label="-s: dir_src = Argument\n-d: dir_dest = Argument\n-v: bool_verboseMode = 1"];
  help [shape=parallelogram, style=filled, fillcolor="#e6f4e6", label="-h / -H:\nHilfetext ausgeben"];
  e0a [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Ende (Exit 0)"];
  c [shape=record, style=filled, fillcolor="#f3e6f7", label="| -c: Konfiguration laden\n(PAP 3) |"];
  x [shape=record, style=filled, fillcolor="#f3e6f7", label="| -x: systemd-Units aktualisieren\n(PAP 4) |"];
  e0b [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Ende (Exit 0)"];
  bad [shape=parallelogram, style=filled, fillcolor="#e6f4e6", label="Argument fehlt (:) oder\nunbekannte Option (?):\nFehler + Hilfetext"];
  e1 [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Ende (Exit 1)"];
  s -> more;
  more -> sw [label="ja"];
  more -> ret [label="nein"];
  sw -> set [label="-s -d -v"];
  sw -> help [label="-h -H"];
  sw -> c [label="-c"];
  sw -> x [label="-x"];
  sw -> bad [label="Fehler"];
  help -> e0a;
  x -> e0b;
  bad -> e1;
  set -> more [constraint=false];
  c -> more [constraint=false];
}
