digraph G {
  graph [rankdir=TB, nodesep=0.45, ranksep=0.32, fontname="DejaVu Sans", labelloc=t, fontsize=14, label="PAP 1: minibak.sh - main program", pad=0.3];
  node [fontname="DejaVu Sans", fontsize=11, margin="0.16,0.08"];
  edge [fontname="DejaVu Sans", fontsize=10];
  s [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Start: minibak [options]"];
  root [shape=diamond, style=filled, fillcolor="#fff4d6", label="EUID = 0?"];
  sudo [shape=box, style=filled, fillcolor="#ffffff", label="exec sudo bash \"$0\" \"$@\"\n(restart as root)"];
  init [shape=box, style=filled, fillcolor="#ffffff", label="Set defaults,\ndefine help texts"];
  tmp [shape=box, style=filled, fillcolor="#ffffff", label="Create /tmp/minibak,\nwrite start line to temp log"];
  opt [shape=record, style=filled, fillcolor="#f3e6f7", label="| Process options\n(PAP 2) |"];
  d1 [shape=diamond, style=filled, fillcolor="#fff4d6", label="dir_src set?"];
  d2 [shape=diamond, style=filled, fillcolor="#fff4d6", label="dir_src exists?"];
  d3 [shape=diamond, style=filled, fillcolor="#fff4d6", label="dir_dest set?"];
  d4 [shape=diamond, style=filled, fillcolor="#fff4d6", label="dir_dest exists?"];
  mk [shape=box, style=filled, fillcolor="#ffffff", label="mkdir --parents dir_dest"];
  d5 [shape=diamond, style=filled, fillcolor="#fff4d6", label="created?"];
  err [shape=parallelogram, style=filled, fillcolor="#e6f4e6", label="Error message,\nlog entry"];
  e1 [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Exit 1"];
  names [shape=box, style=filled, fillcolor="#ffffff", label="currentBackupDir = dir_dest/backup_<timestamp>\nlastBackup = newest entry in dir_dest"];
  d6 [shape=diamond, style=filled, fillcolor="#fff4d6", label="dir_dest empty?"];
  full [shape=box, style=filled, fillcolor="#ffffff", label="mkdir currentBackupDir\nrsync -aH dir_src currentBackupDir"];
  inc [shape=box, style=filled, fillcolor="#ffffff", label="mkdir currentBackupDir\nrsync -aHv --link-dest=lastBackup\ndir_src currentBackupDir"];
  ev [shape=box, style=filled, fillcolor="#ffffff", label="Evaluate rsync exit code,\nwrite log entry"];
  d7 [shape=diamond, style=filled, fillcolor="#fff4d6", label="exit code = 0?"];
  prune [shape=record, style=filled, fillcolor="#f3e6f7", label="| Retention\n(PAP 5) |"];
  e0 [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Exit 0"];
  en [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Exit with the\nrsync exit code"];
  s -> root;
  root -> init [label="yes"];
  root -> sudo [label="no"];
  init -> tmp;
  tmp -> opt;
  opt -> d1;
  d1 -> d2 [label="yes"];
  d1 -> err [label="no"];
  d2 -> d3 [label="yes"];
  d2 -> err [label="no"];
  d3 -> d4 [label="yes"];
  d3 -> err [label="no"];
  d4 -> names [label="yes"];
  d4 -> mk [label="no"];
  mk -> d5;
  d5 -> names [label="yes"];
  d5 -> err [label="no"];
  err -> e1;
  names -> d6;
  d6 -> full [label="yes"];
  d6 -> inc [label="no"];
  full -> ev;
  inc -> ev;
  ev -> d7;
  d7 -> prune [label="yes"];
  d7 -> en [label="no"];
  prune -> e0;
  sudo -> s [label="(starts again as root)", constraint=false, style=dashed];
}
