digraph G {
  graph [rankdir=TB, nodesep=0.45, ranksep=0.32, fontname="DejaVu Sans", labelloc=t, fontsize=14, label="PAP 7: install.sh uninstall - Deinstallation", pad=0.3];
  node [fontname="DejaVu Sans", fontsize=11, margin="0.16,0.08"];
  edge [fontname="DejaVu Sans", fontsize=10];
  s [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Start: ./install.sh uninstall"];
  root [shape=diamond, style=filled, fillcolor="#fff4d6", label="EUID = 0?"];
  sudo [shape=box, style=filled, fillcolor="#ffffff", label="exec sudo bash \"$0\" \"$@\""];
  intro [shape=parallelogram, style=filled, fillcolor="#e6f4e6", label="Einleitungstext anzeigen"];
  d1 [shape=diamond, style=filled, fillcolor="#fff4d6", label="fortfahren? (y/N)"];
  e1 [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Ende (Exit 1)"];
  q [shape=parallelogram, style=filled, fillcolor="#e6f4e6", label="fragen: rsync entfernen? Logs löschen?\nKonfiguration löschen? /tmp/minibak leeren?\n(Standard: nein)"];
  rmbin [shape=box, style=filled, fillcolor="#ffffff", label="/usr/bin/minibak löschen\n(Warnung falls nicht vorhanden)"];
  d2 [shape=diamond, style=filled, fillcolor="#fff4d6", label="minibak.timer bekannt\nund aktiviert?"];
  dt [shape=box, style=filled, fillcolor="#ffffff", label="systemctl disable --now minibak.timer"];
  d3 [shape=diamond, style=filled, fillcolor="#fff4d6", label="minibak.service bekannt?"];
  wait [shape=box, style=filled, fillcolor="#ffffff", label="warten solange der Service\nactive oder activating ist,\ndanach systemctl stop"];
  rmu [shape=box, style=filled, fillcolor="#ffffff", label="minibak.timer und minibak.service in\n/etc/systemd/system löschen\n(Warnung falls nicht vorhanden)"];
  rl [shape=box, style=filled, fillcolor="#ffffff", label="systemctl daemon-reload\nsystemctl reset-failed"];
  d4 [shape=diamond, style=filled, fillcolor="#fff4d6", label="Antwort ja: rsync?"];
  o4 [shape=box, style=filled, fillcolor="#ffffff", label="apt-get -y remove rsync"];
  d5 [shape=diamond, style=filled, fillcolor="#fff4d6", label="Antwort ja: Logs?"];
  o5 [shape=box, style=filled, fillcolor="#ffffff", label="/var/log/minibak.log löschen"];
  d6 [shape=diamond, style=filled, fillcolor="#fff4d6", label="Antwort ja: Konfiguration?"];
  o6 [shape=box, style=filled, fillcolor="#ffffff", label="/etc/minibak.conf und\n/etc/minibak.conf.template löschen"];
  d7 [shape=diamond, style=filled, fillcolor="#fff4d6", label="Antwort ja: /tmp?"];
  o7 [shape=box, style=filled, fillcolor="#ffffff", label="/tmp/minibak löschen"];
  e0 [shape=box, style="rounded,filled", fillcolor="#dfe9f7", label="Ende (Backups bleiben unberührt)"];
  s -> root;
  root -> intro [label="ja"];
  root -> sudo [label="nein"];
  intro -> d1;
  d1 -> q [label="ja"];
  d1 -> e1 [label="nein"];
  q -> rmbin;
  rmbin -> d2;
  d2 -> dt [label="ja"];
  d2 -> d3 [label="nein"];
  dt -> d3;
  d3 -> wait [label="ja"];
  d3 -> rmu [label="nein"];
  wait -> rmu;
  rmu -> rl;
  rl -> d4;
  d4 -> o4 [label="ja"];
  d4 -> d5 [label="nein"];
  o4 -> d5;
  d5 -> o5 [label="ja"];
  d5 -> d6 [label="nein"];
  o5 -> d6;
  d6 -> o6 [label="ja"];
  d6 -> d7 [label="nein"];
  o6 -> d7;
  d7 -> o7 [label="ja"];
  d7 -> e0 [label="nein"];
  o7 -> e0;
  sudo -> s [label="(startet erneut als root)", constraint=false, style=dashed];
}
